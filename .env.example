PORT=8083
LOG_LEVEL=INFO

# ---------- Google AI Studio ----------
# Principal: gemini-3.8-flash   |   Respaldo: gemini-3.6-flash
# SIN el prefijo "models/"
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Timeout por intento. 20s porque hay reintentos encima: con 60s el peor
# caso (reintentos + fallback) supera lo que aguantan el móvil y Cloud Run.
GEMINI_TIMEOUT=20
# Reintentos al modelo principal antes de caer al fallback. Bajo (1) porque
# es un endpoint síncrono que un usuario está esperando, no un worker en background.
GEMINI_MAX_RETRIES=1
GEMINI_RETRY_BACKOFF_MS=1000
# Techo de tokens de salida en TODAS las llamadas (no solo documentos). Sin esto se
# hereda el default del modelo y una extracción larga se corta en silencio. Es un techo,
# no un objetivo: no alarga las respuestas del chat. Ojo: en los modelos que razonan, los
# tokens de pensamiento salen de este mismo presupuesto (se ven como thoughtsTokens en el
# log). Si Gemini responde 400 porque excede el máximo del modelo, bajar este valor.
GEMINI_MAX_OUTPUT_TOKENS=32768
GEMINI_MAX_TOOL_ITERATIONS=5
GEMINI_MAX_HISTORY=20
# Turnos recientes que reenvían el binario real a Gemini; los más viejos se
# sustituyen por un marcador de texto ("[el usuario adjuntó una imagen]").
GEMINI_MAX_HISTORY_ATTACHMENTS=2

# ---------- Supabase: Transaction Pooler, puerto 6543 ----------
DB_URL=jdbc:postgresql://changeme.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=changeme
DB_PASSWORD=changeme
DB_POOL_SIZE=3

# ---------- Supabase: Storage ----------
SUPABASE_URL=https://changeme.supabase.co
SUPABASE_SERVICE_KEY=changeme
SUPABASE_BUCKET=ai-attachments
SUPABASE_SIGNED_URL_TTL=3600

# ---------- JWT: RS256 contra el JWKS de user-service (etapa 3.5) ----------
JWT_JWKS_URI=https://user-microservice-pets-20369076707.us-central1.run.app/.well-known/jwks.json
JWT_ISSUER=myanimalog-user-service
JWT_AUDIENCE=myanimalog-api

# ---------- Google Cloud ----------
GCP_PROJECT_ID=changeme

# ---------- Salida hacia los demás microservicios ----------
GATEWAY_URL=https://changeme.run.app
# Base URL por servicio (no todo por el gateway): en desarrollo cada uno corre en
# un sitio distinto y el gateway puede no enrutar los de Node. En producción se
# apunta al gateway cambiando estas variables, sin tocar código.
PET_SERVICE_URL=http://localhost:8081
MEDICAL_SERVICE_URL=http://localhost:3000
CALENDAR_SERVICE_URL=https://calendar-microservice-20369076707.us-central1.run.app
SERVICES_TIMEOUT=10

# ---------- Zona horaria del usuario (para resolver fechas relativas) ----------
APP_TIMEZONE=America/Bogota

# ---------- Upstash Redis ----------
REDIS_HOST=changeme.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ---------- Límites ----------
MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=25MB
RATELIMIT_CHAT_RPM=10
RATELIMIT_DOCS_RPH=20
# Tamaño máximo de un documento para /api/ai/documents/analyze (PDF o imagen, un solo archivo).
DOCUMENTS_MAX_BYTES=15728640